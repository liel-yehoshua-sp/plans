{
  "name": "plan",
  "private": true,
  "description": "File-backed .plan/ portfolios — store, CLI, local viewer",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "plan": "node ./packages/cli/dist/index.js",
    "plan:viewer": "npm run dev -w @plan/viewer"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
