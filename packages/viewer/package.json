{
  "name": "@plans/viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local read-only viewer for file-backed .plan/ epics, stories, and tasks",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "scripts": {
    "prebuild": "npm run build -w @plans/store",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@plans/store": "*",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  }
}
